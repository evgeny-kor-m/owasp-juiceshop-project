# ===========================================
# ОСНОВНЫЕ ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ===========================================

# Базовые URL для тестов
JUICESHOP_BASE_URL=http://host.docker.internal:8080
API_BASE_URL=http://host.docker.internal:8080/api

# Порты для сервисов
TEST_RUNNER_PORT=4040
ALLURE_PORT=5050

# Ресурсы контейнера test-runner
MEMORY_LIMIT=1G
MEMORY_RESERVATION=1G
CPU_LIMIT=1
CPU_RESERVATION=0.5

# Allure конфигурация
ALLURE_CHECK_INTERVAL=10
ALLURE_KEEP_HISTORY=1
ALLURE_HISTORY_LATEST=25

# Пути к директориям (относительно docker/)
ALLURE_RESULTS_PATH=../allure-results
ALLURE_REPORT_PATH=../allure-reports
HTML_REPORT_PATH=../html-reports
PROJECT_ROOT_PATH=..

# Docker образы
TEST_RUNNER_IMAGE=test-runner:latest
ALLURE_IMAGE=frankescobar/allure-docker-service

# Python конфигурация
PYTHONPATH=/app
LOG_LEVEL=INFO

# Дополнительные настройки для разных сред
ENVIRONMENT=local