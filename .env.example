# ===========================================
# ПРИМЕР ФАЙЛА ОКРУЖЕНИЯ
# Скопируй этот файл в .env и настрой под себя
# ===========================================

# Базовые URL для тестов
JUICESHOP_BASE_URL=http://host.docker.internal:8080
API_BASE_URL=http://host.docker.internal:8080/api

# Порты для сервисов (измени если заняты)
TEST_RUNNER_PORT=4040
ALLURE_PORT=5050

# Ресурсы контейнера (настрой под свою машину)
MEMORY_LIMIT=1G
MEMORY_RESERVATION=1G
CPU_LIMIT=1
CPU_RESERVATION=0.5

# Allure настройки
ALLURE_CHECK_INTERVAL=10
ALLURE_KEEP_HISTORY=1
ALLURE_HISTORY_LATEST=25

# Пути (обычно не меняются)
ALLURE_RESULTS_PATH=../allure-results
ALLURE_REPORT_PATH=../allure-report
PROJECT_ROOT_PATH=..

# Docker образы
TEST_RUNNER_IMAGE=test-runner:latest
ALLURE_IMAGE=frankescobar/allure-docker-service

# Python
PYTHONPATH=/app
LOG_LEVEL=INFO

# Среда выполнения
ENVIRONMENT=local

# ===========================================
# ПРИМЕРЫ ДЛЯ РАЗНЫХ СРЕД:
# ===========================================

# Для CI/CD:
# JUICESHOP_BASE_URL=http://juiceshop-service:3000
# ENVIRONMENT=ci
# LOG_LEVEL=DEBUG

# Для staging:
# JUICESHOP_BASE_URL=https://staging.example.com
# ENVIRONMENT=staging

# Для production тестов:
# JUICESHOP_BASE_URL=https://prod.example.com
# ENVIRONMENT=production