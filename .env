# ===========================================
# .env MAIN ENVIRONMENT VARIABLES
# ===========================================

# Base URLs for tests.
#JUICESHOP_BASE_URL=http://host.docker.internal:8080
API_BASE_URL=http://host.docker.internal:8080
WEB_BASE_URL=http://juice-shop.local:8080
URL_PREFIX=http://localhost:5050/allure

# Ports for services
TEST_RUNNER_PORT=4040
ALLURE_PORT=5050

# Test runner container resources
MEMORY_LIMIT=1G
MEMORY_RESERVATION=1G
CPU_LIMIT=1
CPU_RESERVATION=0.5

# Allure configuration
ALLURE_CHECK_INTERVAL=10
ALLURE_KEEP_HISTORY=1
ALLURE_HISTORY_LATEST=25

# Paths to directories (relative to docker/)
ALLURE_RESULTS_PATH=./allure-results
ALLURE_REPORT_PATH=./allure-reports
HTML_REPORT_PATH=./html-reports
LOGS_PATH=./logs
SCREENSHOTS=./screenshots
PROJECT_ROOT_PATH=.

# Docker images
TEST_RUNNER_IMAGE=test-runner:latest
ALLURE_IMAGE=frankescobar/allure-docker-service

# Python configuration
PYTHONPATH=/app
LOG_LEVEL=INFO
ENVIRONMENT=local # Additional settings for different environments